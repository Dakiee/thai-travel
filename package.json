{
  "name": "our-thailand-trip",
  "version": "1.0.0",
  "private": true,
  "description": "A personal Thailand trip board for two adults departing Ulaanbaatar.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "build:cloudflare": "npm run build",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "start": "next start",
    "test": "node --test tests/planner.test.js"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "wrangler": "4.134.0"
  }
}
